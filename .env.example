# Copier en .env puis ajuster.
POSTGRES_DB=oeil_bleu
POSTGRES_USER=oeil_bleu
POSTGRES_PASSWORD=changer-moi
DATABASE_URL=postgresql://oeil_bleu:changer-moi@localhost:5432/oeil_bleu
# Clé gratuite FIRMS : https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Dossier d'archivage des données brutes (preuves)
DONNEES_BRUTES=data/brut
# Facultatif : emprise de collecte "ouest,sud,est,nord" ; sinon celle des points surveillés
# EMPRISE=-17.5,10,0,17
# Clé d'API Claude pour les agents (console.anthropic.com)
ANTHROPIC_API_KEY=
# Envoi du bulletin
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
BULLETIN_EXPEDITEUR=bulletin@oeilbleu.org
# Destinataires séparés par des virgules ; ils reçoivent le bulletin en copie cachée
BULLETIN_DESTINATAIRES=
