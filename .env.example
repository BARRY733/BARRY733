POSTGRES_PASSWORD=changer-moi
DATABASE_URL=postgresql://oeil_bleu:changer-moi@127.0.0.1:5432/oeil_bleu

# Étape 2 : collecte
# Clé gratuite : https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
CDSAPI_URL=https://ewds.climate.copernicus.eu/api
# Compte gratuit Copernicus EWDS
CDSAPI_KEY=

# Radar Sentinel-1 : aucune clé. Première collecte sur un an pour établir la référence :
#   python -m oeil_bleu collecter sentinel1 --debut 2023-09-01 --fin 2024-08-31

# Étape 4 : agents (clé sur console.anthropic.com)
ANTHROPIC_API_KEY=

# Page de validation (python -m oeil_bleu web, ou en HTTPS : docker compose --profile web up -d)
# Domaine public de la page, qui doit pointer vers le serveur
DOMAINE=
DIRECTEUR_NOM="Prénom Nom"
DIRECTEUR_MOT_DE_PASSE=
# Clé de session ; à fixer pour ne pas déconnecter à chaque redémarrage (python -c "import secrets; print(secrets.token_hex(32))")
OEIL_BLEU_SECRET=

# Étape 5 : envoi du bulletin (tout fournisseur SMTP)
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR="Œil Bleu <bulletin@exemple.org>"
